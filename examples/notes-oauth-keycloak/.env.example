PORT=3000

# Comma-separated list of additional allowed hosts (for deployment behind reverse proxies)
# ALLOWED_HOSTS=my-server.example.com,my-server.us-central1.run.app

# OAuth Configuration
# example: preset for the Keycloak in docker-compose.yml. If you change
# KEYCLOAK_PORT, change the port here too.
OAUTH_ISSUER_URL=http://localhost:8080/realms/mcp-realm

# Keycloak access tokens carry no audience for this server by default, so leave
# this empty. Set it once you add an audience mapper in Keycloak.
OAUTH_AUDIENCE=
